// FarmFlow - Chicken Retail Management System
// Prisma Schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  BRANCH_MANAGER
  SALES_EMPLOYEE
}

enum DispatchStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum MovementType {
  DISPATCH_IN
  SALE_OUT
  DEAD_DAMAGED
  ADJUSTMENT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Business {
  id                 String   @id @default(cuid())
  name               String
  address            String?
  phone              String?
  email              String?
  timezone           String   @default("Asia/Kolkata")
  currency           String   @default("INR")
  allowNegativeStock Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  users             User[]
  branches          Branch[]
  suppliers         Supplier[]
  expenseCategories ExpenseCategory[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  business           Business        @relation(fields: [businessId], references: [id])
  managedBranches    Branch[]        @relation("BranchManager")
  userBranches       UserBranch[]
  henDispatches      HenDispatch[]   @relation("DispatchCreator")
  receivedDispatches HenDispatch[]   @relation("DispatchReceiver")
  retailSales        RetailSale[]    @relation("SaleCreator")
  expenses           Expense[]       @relation("ExpenseCreator")
  stockMovements     StockMovement[] @relation("MovementCreator")
  dailyClosings      DailyClosing[]  @relation("ClosingCreator")
  auditLogs          AuditLog[]

  @@index([businessId])
  @@index([role])
  @@index([isActive])
}

model Branch {
  id                 String   @id @default(cuid())
  businessId         String
  name               String
  code               String   @unique
  address            String?
  contactNumber      String?
  managerId          String?
  currentBirdStock   Int      @default(0)
  currentWeightStock Decimal  @default(0) @db.Decimal(10, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  business       Business        @relation(fields: [businessId], references: [id])
  manager        User?           @relation("BranchManager", fields: [managerId], references: [id])
  userBranches   UserBranch[]
  henDispatches  HenDispatch[]
  retailSales    RetailSale[]
  expenses       Expense[]
  stockMovements StockMovement[]
  dailyClosings  DailyClosing[]
  auditLogs      AuditLog[]

  @@index([businessId])
  @@index([managerId])
  @@index([isActive])
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  business      Business      @relation(fields: [businessId], references: [id])
  henDispatches HenDispatch[]

  @@index([businessId])
  @@index([isActive])
}

model HenDispatch {
  id                  String         @id @default(cuid())
  dispatchNumber      String         @unique
  dispatchDate        DateTime
  supplierId          String?
  branchId            String
  vehicleNumber       String?
  numberOfJalis       Int
  birdsPerJali        Int?
  totalBirdCount      Int
  grossWeight         Decimal        @db.Decimal(10, 2)
  emptyJaliWeight     Decimal        @db.Decimal(10, 2)
  netWeight           Decimal        @db.Decimal(10, 2)
  dressedWeight       Decimal?       @db.Decimal(10, 2)
  jaliCharge          Decimal        @default(0) @db.Decimal(10, 2)
  purchaseRatePerKg   Decimal        @db.Decimal(10, 2)
  totalPurchaseAmount Decimal        @db.Decimal(12, 2)
  status              DispatchStatus @default(PENDING)
  receivedAt          DateTime?
  receivedById        String?
  cancelledAt         DateTime?
  cancelReason        String?
  notes               String?
  idempotencyKey      String?        @unique
  createdById         String
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  createdBy  User      @relation("DispatchCreator", fields: [createdById], references: [id])
  receivedBy User?     @relation("DispatchReceiver", fields: [receivedById], references: [id])

  @@index([branchId])
  @@index([supplierId])
  @@index([dispatchDate])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
}

model RetailSale {
  id                   String    @id @default(cuid())
  saleNumber           String    @unique
  saleDate             DateTime
  branchId             String
  sellingPricePerKg    Decimal   @db.Decimal(10, 2)
  totalWeightSold      Decimal   @db.Decimal(10, 2)
  numberOfBirdsSold    Int       @default(0)
  tokensIssued         Int       @default(0)
  closingStockKg       Decimal?  @db.Decimal(10, 2)
  mortalityWeightKg    Decimal   @default(0) @db.Decimal(10, 2)
  salesAmount          Decimal   @db.Decimal(12, 2)
  cashReceived         Decimal   @db.Decimal(12, 2)
  upiReceived          Decimal   @db.Decimal(12, 2)
  otherPayment         Decimal   @db.Decimal(12, 2)
  totalPaymentReceived Decimal   @db.Decimal(12, 2)
  difference           Decimal   @db.Decimal(12, 2)
  notes                String?
  idempotencyKey       String?   @unique
  createdById          String
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("SaleCreator", fields: [createdById], references: [id])

  @@index([branchId])
  @@index([saleDate])
  @@index([createdById])
  @@index([deletedAt])
}

model ExpenseCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  business Business  @relation(fields: [businessId], references: [id])
  expenses Expense[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([isActive])
}

model Expense {
  id             String        @id @default(cuid())
  expenseDate    DateTime
  branchId       String
  categoryId     String
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  description    String?
  idempotencyKey String?       @unique
  createdById    String
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  branch    Branch          @relation(fields: [branchId], references: [id])
  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy User            @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([branchId])
  @@index([categoryId])
  @@index([expenseDate])
  @@index([createdById])
  @@index([deletedAt])
}

model StockMovement {
  id            String       @id @default(cuid())
  date          DateTime
  branchId      String
  movementType  MovementType
  birdCount     Int
  weight        Decimal      @db.Decimal(10, 2)
  referenceId   String?
  referenceType String?
  notes         String?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("MovementCreator", fields: [createdById], references: [id])

  @@index([branchId])
  @@index([date])
  @@index([movementType])
  @@index([referenceId])
  @@index([createdById])
}

model DailyClosing {
  id                       String    @id @default(cuid())
  date                     DateTime
  branchId                 String
  openingBirdCount         Int
  birdsReceived            Int       @default(0)
  birdsSold                Int       @default(0)
  birdsDeadOrDamaged       Int       @default(0)
  otherBirdAdjustments     Int       @default(0)
  expectedClosingBirdCount Int       @default(0)
  closingBirdCount         Int
  birdDifference           Int       @default(0)
  openingWeight            Decimal   @db.Decimal(10, 2)
  weightReceived           Decimal   @default(0) @db.Decimal(10, 2)
  weightSold               Decimal   @default(0) @db.Decimal(10, 2)
  otherWeightAdjustments   Decimal   @default(0) @db.Decimal(10, 2)
  expectedClosingWeight    Decimal   @default(0) @db.Decimal(10, 2)
  closingWeight            Decimal   @db.Decimal(10, 2)
  weightDifference         Decimal   @default(0) @db.Decimal(10, 2)
  openingCashBalance       Decimal   @db.Decimal(12, 2)
  totalSalesAmount         Decimal   @db.Decimal(12, 2)
  totalExpensesAmount      Decimal   @db.Decimal(12, 2)
  totalCashReceived        Decimal   @db.Decimal(12, 2)
  totalUpiReceived         Decimal   @db.Decimal(12, 2)
  totalOtherPayment        Decimal   @db.Decimal(12, 2)
  cashDeposited            Decimal   @default(0) @db.Decimal(12, 2)
  expectedCashBalance      Decimal   @default(0) @db.Decimal(12, 2)
  closingCashBalance       Decimal   @db.Decimal(12, 2)
  cashDifference           Decimal   @default(0) @db.Decimal(12, 2)
  isClosed                 Boolean   @default(false)
  closedById               String?
  closedAt                 DateTime?
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  branch   Branch @relation(fields: [branchId], references: [id])
  closedBy User?  @relation("ClosingCreator", fields: [closedById], references: [id])

  @@unique([branchId, date])
  @@index([branchId])
  @@index([date])
  @@index([isClosed])
  @@index([closedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  branchId   String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([branchId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
